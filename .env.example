# Claude Code Context Lab configuration. `python3 lab.py tokens …` creates .env
# (mode 600, gitignored) and fills in the secrets. Only LAB_GH_ORG must be
# set by hand, after `tokens claude` and before `tokens github`.
# Variables already set in the environment win over .env.

# Claude subscription token, from `python3 lab.py tokens claude`.
# Valid for one year; revoke it on claude.ai after the lab.
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub fine-grained PAT, valid 1 day, from `python3 lab.py tokens github`;
# repository access "All repositories" (the org holds only lab repos).
# Permissions (pre-filled): Administration, Contents, Pages, Workflows = write;
# Actions, Metadata = read.
GH_TOKEN=
GH_TOKEN_EXPIRES_AT=

# A new, empty GitHub organization in which you are an admin.
# Set by hand before `python3 lab.py tokens github`.
LAB_GH_ORG=

# Optional: model for all runs without a model (or with `-`) in matrix.conf.
# Default: claude-haiku-5-5 (cheapest current model).
# LAB_MODEL=

# Optional: number of runs per test for `python3 lab.py run` when --repeat
# is not given (a positive integer). Default: 1.
# REPEAT=

# Optional: browser for logins, e.g. a private window, so the right account
# is used when you have several. Read from the environment, not from .env.
# LAB_BROWSER=
